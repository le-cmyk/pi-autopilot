#!/bin/bash
# Safe reboot script for Pi 5
# Ensures clean shutdown: stop Docker, sync, send alert, mark as planned
# Usage: ~/reboot [reason]

set -e

REASON="${1:-manual reboot}"
STATE_FILE="/var/tmp/pi-health-state.json"
BACKUP_SCRIPT="/home/pi/.hermes/scripts/backup-critical-files.sh"
FREEZE_WATCHDOG="/home/pi/.hermes/scripts/pi-freeze-watchdog.sh"

echo "🔄 Pi reboot — $(date)"
echo "   Reason: $REASON"
echo ""

# 1. Mark as planned reboot in health state
if [ -f "$STATE_FILE" ]; then
    python3 -c "
import json
try:
    with open('$STATE_FILE') as f:
        state = json.load(f)
    state['planned_reboot'] = True
    state['reboot_reason'] = '$REASON'
    with open('$STATE_FILE', 'w') as f:
        json.dump(state, f)
    print('✓ Health state: planned reboot flagged')
except Exception as e:
    print(f'⚠ Could not update state: {e}')
" 2>/dev/null || true
fi

# 2. Stop Docker containers cleanly (prevents orphan iptables rules)
if command -v docker &>/dev/null && docker info &>/dev/null 2>&1; then
    echo "Stopping Docker containers..."
    docker stop $(docker ps -q) 2>/dev/null || true
    echo "✓ Docker containers stopped"
fi

# 3. Final freeze heartbeat (marks the clean shutdown moment)
if [ -x "$FREEZE_WATCHDOG" ]; then
    bash "$FREEZE_WATCHDOG" heartbeat 2>/dev/null || true
    echo "✓ Final heartbeat written"
fi

# 4. Backup critical files
if [ -f "$BACKUP_SCRIPT" ]; then
    bash "$BACKUP_SCRIPT" 2>/dev/null && echo "✓ Critical files backed up" || true
fi

# 5. Sync filesystems
sync
echo "✓ Filesystems synced"

# 6. Reboot
echo ""
echo "Rebooting now..."
exec sudo /usr/sbin/reboot